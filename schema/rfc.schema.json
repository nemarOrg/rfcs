{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nemarOrg/rfcs/blob/main/schema/rfc.schema.json",
  "title": "NEMAR RFC front matter",
  "description": "The front matter of one file under text/. Every field is required; a field that does not apply yet is null. Timestamps are UTC, to the minute.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "title",
    "scope",
    "dataset",
    "shepherd",
    "authors",
    "discussion",
    "opened_at",
    "window_days",
    "extension",
    "final_comment_at",
    "proposed_disposition",
    "decision",
    "decided_at",
    "decided_by",
    "adr",
    "supersedes_rfc",
    "withdrawn_at",
    "withdrawn_reason"
  ],
  "properties": {
    "number": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scope": { "enum": ["org", "dataset"] },
    "dataset": {
      "description": "null for an organization RFC; a dataset id such as nm000123 for a dataset RFC.",
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z]{2}[0-9]{6}$" }]
    },
    "shepherd": {
      "description": "The NEMAR owner or admin who opens the RFC and keeps its clock: a name or a GitHub login.",
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "discussion": {
      "description": "The thread, a Discussion in nemarOrg/rfcs; null until the RFC opens.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^https://github\\.com/nemarOrg/rfcs/discussions/[0-9]+$" }
      ]
    },
    "opened_at": {
      "description": "The thread's creation instant in UTC, rounded down to the minute; null while a draft.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/timestamp" }]
    },
    "window_days": { "type": "integer", "minimum": 7, "maximum": 21 },
    "extension": {
      "description": "At most one, of at most 14 days, granted before the close.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["granted_at", "days", "reason"],
          "properties": {
            "granted_at": { "$ref": "#/definitions/timestamp" },
            "days": { "type": "integer", "minimum": 1, "maximum": 14 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "final_comment_at": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/timestamp" }]
    },
    "proposed_disposition": { "enum": [null, "accept", "reject"] },
    "decision": { "enum": [null, "accepted", "rejected", "withdrawn"] },
    "decided_at": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/timestamp" }]
    },
    "decided_by": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "adr": {
      "description": "A link to the Architecture Decision Record the decision produced.",
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^https://[^\\s]+$" }]
    },
    "supersedes_rfc": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 9999 }]
    },
    "withdrawn_at": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/timestamp" }]
    },
    "withdrawn_reason": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    }
  },
  "allOf": [
    {
      "description": "An organization RFC has no dataset; a dataset RFC names one.",
      "if": { "properties": { "scope": { "const": "org" } }, "required": ["scope"] },
      "then": { "properties": { "dataset": { "type": "null" } } },
      "else": { "properties": { "dataset": { "type": "string" } } }
    },
    {
      "description": "The thread and the opening instant are set together, by the merge that opens the RFC.",
      "if": { "properties": { "opened_at": { "type": "null" } }, "required": ["opened_at"] },
      "then": { "properties": { "discussion": { "type": "null" } } },
      "else": { "properties": { "discussion": { "type": "string" } } }
    }
  ],
  "definitions": {
    "timestamp": {
      "description": "UTC, to the minute: YYYY-MM-DDTHH:MM:00Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:00Z$"
    }
  }
}
