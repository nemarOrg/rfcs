{
  "name": "nemar-rfcs",
  "description": "NEMAR Requests for Comment: the record, the index and the clock",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/nemarOrg/rfcs"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run src/check.ts",
    "index": "bun run src/index-gen.ts",
    "next-number": "bun run src/next-number.ts",
    "clock": "bun run src/clock.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
